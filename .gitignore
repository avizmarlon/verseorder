# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/out-redirect/
.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only development instructions and operator workspaces
AGENTS.md
**/AGENTS.md
CLAUDE.md
**/CLAUDE.md
GEMINI.md
**/GEMINI.md
.codex/
.claude/
.agents/
.cursorrules
.cursor/rules/
docs/internal/
private/
*.private.md
*.local.md
*.local.json
.env*
!.env.example

# Temporary visual and browser test outputs
test-results/
playwright-report/
screenshots/

# Local-only product, planning, design and technical markdown.
# This does not ignore public README, CONTRIBUTING or editorial content/.
docs/*.md
docs/**/*.md

docs/previews/

# Card trailer media (prototype). Not committed: large binaries, and they are meant to live on a
# separate static media host (NEXT_PUBLIC_MEDIA_BASE). See public/clips/README.md.
public/clips/*.mp4
public/clips/*.webm

# scripts/media work files (downloads, contact sheets)
/.media-work/

# Python bytecode (scripts/media)
__pycache__/

# Social preview image, rendered on every build by scripts/og/build-og-image.mjs
/public/og/
